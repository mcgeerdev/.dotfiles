#!/usr/bin/env bash
# Move skills along the production line and keep the flat skill tree in sync.
#
# Two independent axes. Ownership says whose skill it is. Lifecycle says how far
# along it is. Promoting never changes ownership; adopting never changes stage.
#
#   owner    stage       location (under ~/.omp/agent/skills)  loaded by
#   adapted  production  <name>                                 every harness
#   adapted  testing     testing/<name>                         omp only, hidden
#   adapted  retired     retired/<name>                         nothing
#   personal production  personal/<name>, linked as <name>      every harness
#   personal testing     personal/testing/<name>                omp only, hidden
#   personal retired     personal/retired/<name>                nothing
#
# The store is the tree. ~/.claude/skills and ~/.agents/skills are symlinks to
# it, so the only links to manage are the flat <name> -> personal/<name> ones.
#
# Every command is idempotent, including `new`. Asking for a state the skill is
# already in reports that and exits 0.

set -euo pipefail

STORE="$HOME/.dotfiles/wow/.omp/agent/skills"

die() { printf 'skill-stage: %s\n' "$1" >&2; exit 1; }

check_owner() {
  case "$1" in adapted|personal) ;; *) die "unknown owner '$1'. Use adapted or personal." ;; esac
}
check_stage() {
  case "$1" in production|testing|retired) ;; *) die "unknown stage '$1'. Use production, testing or retired." ;; esac
}

# Path of a skill relative to the store. Symlinks encode exactly this.
subpath_of() { # owner stage name
  local pre=""
  [ "$1" = personal ] && pre="personal/"
  case "$2" in
    production) printf '%s%s' "$pre" "$3" ;;
    *) printf '%s%s/%s' "$pre" "$2" "$3" ;;
  esac
}

path_of() { printf '%s/%s' "$STORE" "$(subpath_of "$1" "$2" "$3")"; }

# A personal production link sits in the adapted production slot, so that slot
# only counts when it holds a real directory.
exists_at() { # owner stage name
  local dir
  dir="$(path_of "$1" "$2" "$3")"
  [ -f "$dir/SKILL.md" ] || return 1
  [ "$1/$2" != adapted/production ] || [ ! -L "$dir" ]
}

# Echoes "<owner> <stage>", or fails when the skill does not exist.
locate() {
  local name="$1" owner stage
  for owner in adapted personal; do
    for stage in production testing retired; do
      if exists_at "$owner" "$stage" "$name"; then
        printf '%s %s' "$owner" "$stage"; return 0
      fi
    done
  done
  return 1
}

is_live() { [ "$1" = production ]; }

# Personal production skills, the only ones that need a flat link.
linked_names() {
  local f
  for f in "$STORE"/personal/*/SKILL.md; do
    [ -f "$f" ] || continue
    basename "$(dirname "$f")"
  done | sort -u
}

# hide: true belongs on testing skills and nowhere else.
set_hide() { # file stage
  local f="$1" stage="$2"
  if [ "$stage" = testing ]; then
    grep -q '^hide: true$' "$f" || sed -i '' '/^description:/a\
hide: true
' "$f"
  else
    sed -i '' '/^hide: true$/d' "$f"
  fi
}

# Drop flat links that no longer point at a personal production skill, then add
# the missing ones. Links that do not point into personal/ are never touched.
relink() {
  local entry target name live added=0 removed=0
  live="$(linked_names)"
  for entry in "$STORE"/*; do
    [ -L "$entry" ] || continue
    target="$(readlink "$entry")"
    case "$target" in personal/*) ;; *) continue ;; esac
    name="$(basename "$entry")"
    if ! printf '%s\n' "$live" | grep -qx "$name" || [ ! -f "$entry/SKILL.md" ]; then
      rm "$entry"; removed=$((removed + 1))
    fi
  done
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    { [ -e "$STORE/$name" ] || [ -L "$STORE/$name" ]; } && continue
    ln -s "personal/$name" "$STORE/$name"
    added=$((added + 1))
  done <<< "$live"
  printf 'links: %d added, %d removed\n' "$added" "$removed"
}

# Single mover. Pass `-` on either axis to hold its current value.
settle() { # name owner|- stage|-
  local name="$1" to_owner="$2" to_stage="$3" from_owner from_stage src dst location
  location=$(locate "$name") || die "no skill named '$name'."
  read -r from_owner from_stage <<< "$location"
  [ "$to_owner" = - ] && to_owner="$from_owner"
  [ "$to_stage" = - ] && to_stage="$from_stage"
  check_owner "$to_owner"; check_stage "$to_stage"
  if [ "$from_owner" = "$to_owner" ] && [ "$from_stage" = "$to_stage" ]; then
    printf '%s is already %s/%s\n' "$name" "$to_owner" "$to_stage"; return 0
  fi
  src="$(path_of "$from_owner" "$from_stage" "$name")"
  dst="$(path_of "$to_owner" "$to_stage" "$name")"
  # Releasing a personal production skill lands where its own flat link sits.
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "personal/$name" ]; then rm "$dst"; fi
  mkdir -p "$(dirname "$dst")"
  mv "$src" "$dst"
  set_hide "$dst/SKILL.md" "$to_stage"
  relink >/dev/null
  printf '%s: %s/%s -> %s/%s\n' "$name" "$from_owner" "$from_stage" "$to_owner" "$to_stage"
}

cmd_list() {
  local owner stage f name
  printf '%-36s %-9s %-11s %s\n' SKILL OWNER STAGE LOADED
  for owner in adapted personal; do
    for stage in production testing retired; do
      for f in "$(path_of "$owner" "$stage" '')"*/SKILL.md; do
        [ -f "$f" ] || continue
        name="$(basename "$(dirname "$f")")"
        exists_at "$owner" "$stage" "$name" || continue
        if is_live "$stage"; then
          printf '%-36s %-9s %-11s %s\n' "$name" "$owner" "$stage" "every harness"
        elif [ "$stage" = testing ]; then
          printf '%-36s %-9s %-11s %s\n' "$name" "$owner" "$stage" "omp, hidden"
        else
          printf '%-36s %-9s %-11s %s\n' "$name" "$owner" "$stage" "no"
        fi
      done
    done
  done
}

cmd_new() {
  local name="${1:?usage: skill-stage new <name> [--personal]}" owner=adapted
  [ "${2:-}" = --personal ] && owner=personal
  case "$name" in personal|testing|retired) die "'$name' is a reserved directory name." ;; esac
  local cur_owner cur_stage dir location
  if location=$(locate "$name"); then
    read -r cur_owner cur_stage <<< "$location"
    if [ "$cur_owner" = "$owner" ] && [ "$cur_stage" = testing ]; then
      printf '%s already exists in %s/testing\n' "$name" "$owner"; return 0
    fi
    die "'$name' already exists as $cur_owner/$cur_stage. Use move, promote, adopt or retire."
  fi
  dir="$(path_of "$owner" testing "$name")"
  mkdir -p "$dir"
  {
    printf -- '---\n'
    printf 'name: %s\n' "$name"
    printf 'description: One sentence on what this does, then the phrases that should trigger it.\n'
    printf 'hide: true\n'
    printf -- '---\n\n'
    printf '# %s\n\n' "$name"
    printf '## Process\n\n1. \n\n## Rules\n\n- \n'
  } > "$dir/SKILL.md"
  printf 'created %s in %s/testing\n' "$name" "$owner"
  printf 'Run it deliberately with /skill:%s after restarting OMP.\n' "$name"
}

case "${1:-list}" in
  list) cmd_list ;;
  new) shift; cmd_new "$@" ;;
  promote) settle "${2:?usage: skill-stage promote <name>}" - production ;;
  demote) settle "${2:?usage: skill-stage demote <name>}" - testing ;;
  retire) settle "${2:?usage: skill-stage retire <name>}" - retired ;;
  adopt) settle "${2:?usage: skill-stage adopt <name>}" personal - ;;
  release) settle "${2:?usage: skill-stage release <name>}" adapted - ;;
  move) settle "${2:?usage: skill-stage move <name> <stage>}" - "${3:?missing stage}" ;;
  relink) relink ;;
  *) die "usage: skill-stage [list|new|promote|demote|retire|adopt|release|move|relink]" ;;
esac
