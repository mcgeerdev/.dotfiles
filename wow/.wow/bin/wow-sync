#!/usr/bin/env bash
# wow-sync — apply merged way-of-work releases to this machine: fast-forward
# the live checkout to origin/main, re-stow wow, reinstall the LaunchAgents
# (all but itself: bootout of a running label kills its own process tree).
set -uo pipefail

# mise shims last: gitleaks (pre-commit hook) lives only there, and an
# inactive shim such as gh must not shadow the Homebrew binary.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/share/mise/shims"

repo="$HOME/.dotfiles"

git -C "$repo" fetch origin main --quiet || {
  echo "wow-sync: fetch failed, skipping"; exit 1; }

if [[ $(git -C "$repo" rev-list --count HEAD..origin/main) -eq 0 ]]; then
  echo "wow-sync: main is current, skipping"
  exit 0
fi

exec "$HOME/.wow/bin/attn-run" --id wow:sync --title "wow · apply release" -- \
  bash -c '
    set -euo pipefail
    repo="$HOME/.dotfiles"
    git -C "$repo" pull --ff-only origin main
    cd "$repo" && STOW_FOLDERS=wow ./install.sh
    make -C "$HOME/.wow" digest-install WOW_SKIP=wow.wow-sync
  '
