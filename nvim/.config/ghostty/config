# Ghostty configuration — managed in ~/.dotfiles, stowed to ~/.config/ghostty.
#
# Edit THIS file, never the symlink target in $HOME.
# Reload in place with cmd+shift+, (some options need a new window or restart).
# Full option reference: `ghostty +show-config --default --docs`.
#
# Ghostty's generated "config syntax crash course" boilerplate was removed —
# it documented the file format, not this setup.

# ── Font ────────────────────────────────────────────────────────────────────
# Installed via `brew install --cask font-fira-code-nerd-font`. Note the family
# does NOT appear in `ghostty +list-fonts`, which lists only monospace-
# classified families — the patched non-Mono variant is filtered out. It still
# resolves: `ghostty +show-face --cp=0x68` reports this face, and a bogus family
# falls back to JetBrains Mono instead. Use `...Nerd Font Mono` for strictly
# single-width icon glyphs.
font-family = "FiraCode Nerd Font"
font-size = 16
# Disable ligatures.
font-feature = -liga
# Embolden glyphs slightly.
font-thicken = true

# ── Colors ──────────────────────────────────────────────────────────────────
# Palette lives in themes/matrix (stowed alongside this file).
theme = matrix
# Never rewrite colors for legibility. This theme is ~2.7:1 contrast
# (#426644 on #0f191c), so any contrast flooring would visibly recolor it.
# 1 = disabled, which is also the default; set explicitly so the look cannot
# drift if that default ever changes.
minimum-contrast = 1

# ── Cursor ──────────────────────────────────────────────────────────────────
cursor-style-blink = false

# ── Window ──────────────────────────────────────────────────────────────────
window-width = 110
window-height = 30
window-vsync = false
window-title-font-family = "MonoLisa Variable"

# ── Shell integration ───────────────────────────────────────────────────────
# Let the shell/PS1 own the title instead of shell integration setting it.
# Omitted features keep their defaults, so this disables `title` only and
# leaves cursor/sudo/ssh-env/ssh-terminfo/path untouched.
shell-integration-features = no-title

# ── Notifications ───────────────────────────────────────────────────────────
# Notify when a command finishes. Requires OSC 133 prompt marks, which shell
# integration already provides; disabling `title` above does not affect them.
#
# The trigger and the action are SEPARATE keys, and mixing them is rejected:
# the trigger takes only never | unfocused | always, so an action value like
# `bell,notify` fails validation there.
#
# `unfocused` fires only when this surface is unfocused; `always` also fires
# while you are watching it. The action default is `bell,no-notify`, so
# `notify` must be explicit to get a desktop notification, not just a bell.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
# Minimum command runtime before it notifies (default 5s):
#   notify-on-command-finish-after = 30s

# ── Keybinds ────────────────────────────────────────────────────────────────
# Send ESC-prefixed sequences that TUI apps (nvim, claude, opencode) expect.
keybind = shift+enter=text:\x1b\r
keybind = alt+backspace=text:\x1b\x7f

# Move focus between splits. `down`/`up` are the canonical directions (Ghostty
# normalises the `bottom`/`top` aliases to these); written canonically so this
# file matches `ghostty +show-config`.
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
